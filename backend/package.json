{
    "name": "digital-resume-api",
    "version": "1.0.0",
    "description": "Digital Resume Backend API — Express + TypeScript + Supabase PostgreSQL",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": "22.x"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint src --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.76.1",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.0.0",
        "@types/qrcode": "^1.5.6",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^4.21.2",
        "helmet": "^8.0.0",
        "multer": "^2.2.0",
        "passkit-generator": "^3.5.7",
        "pino": "^9.6.0",
        "puppeteer": "^25.6.0",
        "qrcode": "^1.5.4",
        "typescript": "^5.7.0",
        "zod": "^3.24.4"
    },
    "devDependencies": {
        "eslint": "^9.0.0",
        "pino-pretty": "^13.0.0",
        "tsx": "^4.19.0",
        "vitest": "^3.0.0"
    }
}
